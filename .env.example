# LLM Shield / Prompt-Injection Gauntlet Environment Configuration
# Copy this file to .env and populate with your own API credentials.
# NEVER commit .env to version control.

# Application Configuration
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API
# Required for agent reasoning and tool-calling execution
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# ArmorIQ Platform Governance API
# Required for live runtime authorization interceptor (Phase 5)
ARMORIQ_API_KEY=your_armoriq_api_key_here
ARMORIQ_ENDPOINT=https://api.armoriq.ai/v1
ARMORIQ_AGENT_ID=agent_llm_shield_01
ARMORIQ_ENVIRONMENT=sandbox

# Sandbox Storage Paths (Relative to backend root or absolute)
DATA_DIR=./data
FILE_VAULT_DIR=./data/file_vault
CRM_DATA_PATH=./data/crm/customers.json
EMAIL_OUTBOX_PATH=./data/email_outbox/outbox.json
